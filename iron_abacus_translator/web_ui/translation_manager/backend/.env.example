# Translation Manager Backend Configuration

# Required: Path to catalog database
CATALOG_DB_PATH=/Users/jacki/project_files/translation_project/wuxia_catalog.db

# Required: Source directory with wuxia_* folders
SOURCE_DIR=/Users/jacki/project_files/translation_project/wuxia_individual_files

# Required: Output directory for translations
OUTPUT_DIR=/Users/jacki/project_files/translation_project/translations

# Optional: Log directory
LOG_DIR=./logs

# Optional: Backend port (default: 8001)
BACKEND_PORT=8001

# Required: OpenAI API key (loaded from env_creds.yml in project root)
# OPENAI_API_KEY=your_key_here
