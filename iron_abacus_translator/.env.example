# Wuxia Translation Project - Environment Configuration
# Copy this file to .env and customize for your local environment

# ==============================================================================
# SOURCE DATA PATHS
# ==============================================================================

# Directory containing cleaned JSON source files
# Default: /Users/jacki/project_files/translation_project/cleaned/COMPLETE_ALL_BOOKS
WUXIA_SOURCE_DIR=/path/to/your/cleaned/source/files

# Path to wuxia catalog SQLite database
# Default: /Users/jacki/project_files/translation_project/wuxia_catalog.db
WUXIA_CATALOG_PATH=/path/to/your/wuxia_catalog.db

# Path to wuxia glossary SQLite database
# Default: ./wuxia_glossary.db (project root)
WUXIA_GLOSSARY_DB_PATH=./wuxia_glossary.db

# ==============================================================================
# OUTPUT PATHS
# ==============================================================================

# Directory for translation outputs
# Default: ./translation_data/outputs (project-relative)
WUXIA_OUTPUT_DIR=./translation_data/outputs

# Directory for translation logs
# Default: ./logs/translation (project-relative)
WUXIA_LOG_DIR=./logs/translation

# ==============================================================================
# API KEYS
# ==============================================================================

# OpenAI API key for translation services
OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (optional, for future features)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ==============================================================================
# TRANSLATION SETTINGS (optional overrides)
# ==============================================================================

# OpenAI model to use for translation
# Default: gpt-5-nano-2025-08-07
# TRANSLATION_MODEL=gpt-5-nano-2025-08-07

# API temperature setting (0.0-1.0)
# Default: 0.3
# TRANSLATION_TEMPERATURE=0.3

# Maximum concurrent workers for parallel processing
# Default: 8
# MAX_WORKERS=8

# ==============================================================================
# KINDLE SEND-TO-DEVICE
# ==============================================================================

# Comma-separated Kindle email addresses (xxx@kindle.com)
# KINDLE_EMAILS=you@kindle.com,family@kindle.com
KINDLE_EMAILS=

# SMTP server settings (Gmail defaults)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Connection timeout in seconds (increase for Raspberry Pi / slow networks)
SMTP_TIMEOUT=30

# ==============================================================================
# NOTES
# ==============================================================================

# - Lines starting with # are comments
# - Environment variables override defaults in utils/environment_config.py
# - Paths can be absolute or relative to project root
# - Use forward slashes (/) even on Windows for compatibility
# - Gmail 2FA: Generate an App Password at https://myaccount.google.com/apppasswords
